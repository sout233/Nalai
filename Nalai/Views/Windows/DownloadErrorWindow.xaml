<ui:FluentWindow x:Class="Nalai.Views.Windows.DownloadErrorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:Nalai.Views.Windows"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Nalai.Views.Pages"
                 xmlns:resources="clr-namespace:Nalai.Resources"
                 Title="{Binding  ViewModel.ApplicationTitle,Mode=OneWay}"
                 Width="550"
                 Height="600"
                 d:DataContext="{d:DesignInstance local:DownloadErrorWindow,
                                     IsDesignTimeCreatable=True}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Topmost="True"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="12">
            <StackPanel Orientation="Horizontal">
                <Viewbox Height="24" Width="24">
                    <ui:SymbolIcon Symbol="ErrorCircle20" FontWeight="Bold" />
                </Viewbox>
                <TextBlock FontSize="24" FontWeight="Bold" Text="Download Failed"></TextBlock>
            </StackPanel>
            <TextBlock FontSize="14" Text="{Binding ViewModel.FileName}"></TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="12">
            <ui:CardExpander
                Padding="10"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                IsExpanded="True"
                Margin="0,2"
                Header="Error Details">
                <StackPanel>
                    <ScrollViewer MaxHeight="200">
                        <TextBlock FontSize="14" TextWrapping="Wrap"
                                   Text="{Binding ViewModel.ErrorMessage,Mode=OneWay}">
                        </TextBlock>
                    </ScrollViewer>
                    <ui:Button HorizontalAlignment="Right" Content="Copy" Icon="{ui:SymbolIcon Copy24}"></ui:Button>
                </StackPanel>
            </ui:CardExpander>
            <ui:CardExpander
                Padding="10"
                Margin="0,2"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                IsExpanded="True"
                Header="Help">
                <StackPanel>
                    <ScrollViewer MaxHeight="200">
                        <TextBlock FontSize="14" TextWrapping="Wrap"
                                   Text="No help available for this error.">
                        </TextBlock>
                    </ScrollViewer>
                    <ui:Button HorizontalAlignment="Right" Content="Copy" Icon="{ui:SymbolIcon Copy24}"></ui:Button>
                </StackPanel>
            </ui:CardExpander>

            <ui:TextBox PlaceholderText="File Name" Icon="{ui:SymbolIcon Document24}" Margin="0,2"
                        Text="{Binding ViewModel.FileName,Mode=OneWay}" IsReadOnly="True">
            </ui:TextBox>
            <ui:TextBox PlaceholderText="Url" Icon="{ui:SymbolIcon Link24}" Margin="0,2"
                        Text="{Binding ViewModel.Url,Mode=OneWay}" IsReadOnly="True">
            </ui:TextBox>
        </StackPanel>

        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,8,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ui:Button Content="Retry" Margin="2,0" Icon="{ui:SymbolIcon ArrowClockwise24}"></ui:Button>
                <ui:Button Content="Cancel" Margin="2,0" Icon="{ui:SymbolIcon Dismiss24}"></ui:Button>
            </StackPanel>
        </StackPanel>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle,Mode=OneWay}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/nalai_icon_2x.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>